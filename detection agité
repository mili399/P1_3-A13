from microbit import *
baby_cry = Image("09090:"
               "09090:"
               "00000:"
               "09990:"
               "90009")
baby_straight = Image("09090:"
               "09090:"
               "00000:"
               "99999:"
               "00000")

# Code in a 'while True:' loop repeats forever
while True:
    if accelerometer.get_x() + accelerometer.get_y() + accelerometer.get_z() > 3000:
        set_volume(200)
        audio.play(Sound.SAD)
        display.scroll('shake')
        for i in range(5):
            display.show(baby_cry)
            sleep(500)
            display.show(baby_straight)
            sleep(500)
        display.clear()
